# Copy to secrets.env (gitignored) and fill in. Values are plain text here; kustomize
# turns them into a Secret.
POSTGRES_PASSWORD=
# Must use the same password as above.
GEOGLOBE_DATABASE_URL=postgresql+psycopg://geoglobe:<POSTGRES_PASSWORD>@geoglobe-db:5432/geoglobe
# openssl rand -hex 32
GEOGLOBE_JWT_SECRET=
GEOGLOBE_ANTHROPIC_API_KEY=
