# Copy to .env and fill in. Never commit the real .env file.

# SQLAlchemy database URL. Defaults to a local SQLite file under data/processed/.
DATABASE_URL=sqlite:///data/processed/equities.db

# REQUIRED by SEC's fair-access policy: identify yourself in all requests to
# sec.gov / data.sec.gov as "Sample Company Name AdminContact@sample.com".
# Requests without a real contact identity are subject to rate limiting/blocking.
SEC_USER_AGENT="Your Name your-email@example.com"

# Enable/disable the Yahoo Finance fallback ingestor (unofficial API, used only
# when SEC/Nasdaq/Stooq data is insufficient). Off by default.
ENABLE_YAHOO_FALLBACK=false

# Logging
LOG_LEVEL=INFO
LOG_DIR=data/logs

# API server
API_HOST=0.0.0.0
API_PORT=8000
