# GeoGlobe configuration — copy to `.env` and fill in before
# `docker compose -f docker-compose.prod.yml up`.
#
# Every GEOGLOBE_* variable maps 1:1 to a typed field in
# apps/api/geoglobe_api/config.py (Settings), which validates them at startup and
# refuses to boot on unsafe production settings. Blank means "unset".

# --- Release ----------------------------------------------------------------
GEOGLOBE_VERSION=0.1.0

# --- Postgres (PostGIS + pgvector) ----------------------------------------
POSTGRES_USER=geoglobe
# REQUIRED: generate with `openssl rand -hex 24`
POSTGRES_PASSWORD=
POSTGRES_DB=geoglobe

# --- Web --------------------------------------------------------------------
# Host port for the web container (serves the app and proxies /api).
WEB_PORT=8080

# --- Auth -------------------------------------------------------------------
# On by default. Issue sign-in links with:
#   docker compose -f docker-compose.prod.yml exec api python -m geoglobe_api.issue_token --sub you
# Setting this to false exposes the query endpoints and the agent (which spends your
# Anthropic credits) to anyone who can reach WEB_PORT.
GEOGLOBE_AUTH_REQUIRED=true
# REQUIRED when auth is on; at least 32 chars. Generate with `openssl rand -hex 32`
GEOGLOBE_JWT_SECRET=
# Optional: expected `aud` claim.
GEOGLOBE_JWT_AUDIENCE=

# --- Agent ------------------------------------------------------------------
# "anthropic" (needs GEOGLOBE_ANTHROPIC_API_KEY) or "demo" (deterministic, key-free;
# for smoke tests and offline demos — it ignores the question).
GEOGLOBE_AGENT_LLM=anthropic
GEOGLOBE_ANTHROPIC_API_KEY=
GEOGLOBE_AGENT_PLANNER_MODEL=claude-opus-4-8
GEOGLOBE_AGENT_FAST_MODEL=claude-sonnet-4-6
GEOGLOBE_AGENT_MAX_TURNS=12

# --- Data service guardrails ------------------------------------------------
GEOGLOBE_MAX_ROWS=5000
GEOGLOBE_STATEMENT_TIMEOUT_MS=5000
GEOGLOBE_QUERY_CACHE_TTL_S=300

# --- Data -------------------------------------------------------------------
# Load the bundled demo earthquake dataset after migrations (truncates that table).
GEOGLOBE_SEED_DEMO_DATA=true

# --- Observability ----------------------------------------------------------
GEOGLOBE_TRACE_BUFFER_SIZE=200

# --- CORS -------------------------------------------------------------------
# Only needed when the frontend is served from another origin (e.g. a CDN). JSON list.
# GEOGLOBE_CORS_ORIGINS=["https://globe.example.com"]
