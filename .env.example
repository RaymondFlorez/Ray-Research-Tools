# ---------------------------------------------------------------------------
# Alpha Movement — environment
# The app runs with none of these set: content is served from the seed layer
# and checkout resolves against a local stub. Each key below turns on the
# corresponding production path.
# ---------------------------------------------------------------------------

# Database — Phase 1. Enables the Prisma-backed repository.
DATABASE_URL="postgresql://user:password@localhost:5432/alpha_movement"

# Auth — Phase 1.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Payments — Phase 2. With STRIPE_SECRET_KEY unset, /api/checkout returns a
# computed order and no redirect URL, which is what lets the demo flow finish.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Media — Phase 3.
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
NEXT_PUBLIC_MEDIA_CDN_URL=""

# Calendar sync — Phase 4.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Web Push — Phase 4.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Email — Phase 4.
RESEND_API_KEY=""
