{
  "name": "@picasso/canvas-guard",
  "version": "0.0.0",
  "private": true,
  "description": "Picasso hardening layer: data classification, tenant isolation, the two egress controls, prompt-injection defenses, the degradation ladder, SLO instrumentation and export bundles",
