  },
  "dependencies": {
    "@picasso/canvas-core": "*",
    "@picasso/canvas-router": "*",
    "@picasso/canvas-agents": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.0"
  }
}
