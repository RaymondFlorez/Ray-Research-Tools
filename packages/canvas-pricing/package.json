{
  "name": "@picasso/canvas-pricing",
  "version": "0.0.0",
  "private": true,
  "description": "Picasso pricing bridge: the Rust pricing core as a typed WASM module, and the StrategyNode that computes through it",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@picasso/canvas-core": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.0"
  }
}
